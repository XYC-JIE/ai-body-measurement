/* 页面容器 */
.container {
  padding: 20rpx;
  background: var(--primary-gradient);
  min-height: 100vh;
}

/* 头部样式 */
.header {
  text-align: center;
  padding: 40rpx 0;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 输入组样式 */
.input-group {
  margin-bottom: 40rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: var(--shadow);
}

.label {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
  color: var(--text-1);
}

.input {
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  width: 100%;
}

/* 计算按钮 */
.calculate-btn {
  background: var(--primary);
  color: white;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin: 40rpx 0;
  width: 100%;
}

.calculate-btn:active {
  background: var(--primary-dark);
}

/* 结果容器 */
.result-container {
  background: var(--card);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  display: none;
  box-shadow: var(--shadow);
}

.result-container.show {
  display: block;
  animation: fadeIn 0.5s;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.result-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  margin-bottom: 30rpx;
  color: var(--text-1);
}

.bmi-value {
  display: block;
  text-align: center;
  font-size: 80rpx;
  font-weight: bold;
  color: var(--primary);
  margin-bottom: 20rpx;
}

.bmi-category {
  display: block;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 40rpx;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  display: inline-block;
  margin-left: 50%;
  transform: translateX(-50%);
}

/* BMI刻度尺 */
.bmi-scale {
  margin-top: 40rpx;
}

.scale-bar {
  height: 30rpx;
  background: linear-gradient(90deg, #3498db, #2ecc71, #f1c40f, #e74c3c);
  border-radius: 15rpx;
  position: relative;
}

.indicator {
  position: absolute;
  top: -20rpx;
  transform: translateX(-50%);
  text-align: center;
  transition: left 0.5s ease;
}

.indicator-line {
  height: 50rpx;
  width: 4rpx;
  background: var(--primary);
  margin: 0 auto;
}

.indicator-dot {
  width: 20rpx;
  height: 20rpx;
  background: var(--primary);
  border-radius: 50%;
  margin: 0 auto;
}

.scale-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

/* 信息框 */
.info-box {
  background: #e3f2fd;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.info-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: var(--primary);
  text-align: center;
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.color-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.underweight {
  background: #3498db;
}

.normal {
  background: #2ecc71;
}

.overweight {
  background: #f1c40f;
}

.obese {
  background: #e74c3c;
}

/* 历史记录 */
.history-section {
  background: var(--card);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.history-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: var(--text-1);
  text-align: center;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.history-info {
  flex: 1;
}

.history-bmi {
  font-size: 28rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 10rpx;
}

.history-date {
  font-size: 24rpx;
  color: var(--text-2);
  display: block;
}

.delete-btn {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #ff6b6b;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-left: 20rpx;
}

.delete-btn .icon {
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  line-height: 1;
}

.clear-history {
  text-align: center;
  color: var(--primary);
  font-size: 28rpx;
  padding: 20rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid #eee;
}

/* 历史记录部分样式更新 */
.history-info {
  flex: 1;
  padding-right: 20rpx;
}

.history-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
  font-size: 26rpx;
}

.history-label {
  color: var(--text-2);
  font-weight: 500;
}

.history-value {
  color: var(--text-1);
}

/* 分类样式 */
.underweight {
  color: #3498db;
}

.normal {
  color: #2ecc71;
}

.overweight {
  color: #f1c40f;
}

.obese {
  color: #e74c3c;
}

/* 加载提示 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: white;
  font-size: 28rpx;
}