/* 容器 */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 顶部导航栏 */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.back-btn,
.publish-btn {
  font-size: 32rpx;
  color: #1aad19;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
}

/* 输入框 */
.thought-input {
  width: 100%;
  height: 200rpx;
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin: 20rpx 0;
  box-sizing: border-box;
  border: 1rpx solid #eee;
}

/* 测量报告卡片 */
.report-card {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.report-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.report-title {
  font-size: 32rpx;
  color: #333;
}

/* 分享设置 */
.share-settings {
  background-color: #fff;
  border-radius: 10rpx;
  overflow: hidden;
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  border-bottom: 1rpx solid #eee;
}

.setting-item:last-child {
  border-bottom: none;
}

.icon {
  font-size: 40rpx;
  color: #888;
  margin-right: 20rpx;
}

.text {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.value {
  font-size: 28rpx;
  color: #888;
  margin-right: 10rpx;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* 分组信息 */
.group-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
  padding: 30rpx 20rpx;
  margin-top: 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #888;
}
/* 图片上传区域 */
.image-upload {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.upload-btn {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 1rpx dashed #ccc;
  border-radius: 10rpx;
  color: #888;
}

.image-preview {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.preview-img {
  width: 150rpx;
  height: 150rpx;
  margin-right: 15rpx;
  margin-bottom: 15rpx;
  border-radius: 8rpx;
}