.container { height: 100vh; background: var(--bg); display: flex; flex-direction: column; }
.camera-container { flex: 1; background: #000; display: flex; flex-direction: column; }
.camera-controls { padding: 20px; display: flex; justify-content: space-around; align-items: center; }
.camera-btn { width: 120rpx; height: 120rpx; border-radius: 50%; color: #fff; background: rgba(255,255,255,0.3); display: flex; align-items: center; justify-content: center; }
.camera-btn.take-photo { width: 140rpx; height: 140rpx; background: #fff; color: #000; }
.camera-instruction { padding: 20px; text-align: center; color: #fff; font-size: 28rpx; }
.content { flex: 1; overflow-y: auto; padding: 24rpx; }
.hero { padding: 40rpx 10rpx 30rpx; text-align: center; }
.hero-title { display: block; font-size: 44rpx; font-weight: 800; color: var(--text-1); }
.hero-sub { display: block; margin-top: 12rpx; font-size: 26rpx; color: var(--text-2); }
.form { display: flex; flex-direction: column; }
.input-group { margin-bottom: 32rpx; }
.label { display: block; margin-bottom: 16rpx; font-size: 28rpx; color: var(--text-2); }
.photo-section { margin-bottom: 32rpx; }
.photo-upload { display: flex; gap: 20rpx; }
.upload-item { flex: 1; }
.upload-label { display: block; margin-bottom: 14rpx; font-size: 26rpx; color: var(--text-2); text-align: center; }
.upload-box { height: 300rpx; border: 2rpx dashed #CBD5E1; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; background: #FAFBFC; overflow: hidden; }
.upload-placeholder { display: flex; flex-direction: column; align-items: center; }
.upload-plus { font-size: 64rpx; color: #CBD5E1; }
.upload-text { font-size: 24rpx; color: var(--text-3); }
.preview-image { width: 100%; height: 100%; }
.guide-section { margin-bottom: 32rpx; border: 1rpx solid #E2E8F0; border-radius: var(--radius-md); overflow: hidden; }
.guide-header { padding: 24rpx; display: flex; justify-content: space-between; background: #FAFBFC; }
.guide-title { font-size: 28rpx; color: var(--text-1); }
.guide-arrow { color: var(--text-3); font-size: 24rpx; }
.guide-content { padding: 24rpx; }
.guide-item { display: flex; margin-bottom: 20rpx; }
.guide-number { width: 40rpx; height: 40rpx; border-radius: 50%; background: var(--primary-gradient); color: #fff; text-align: center; line-height: 40rpx; margin-right: 16rpx; font-size: 24rpx; }
.guide-subtitle { display: block; font-weight: 600; color: var(--text-1); margin-bottom: 6rpx; }
.guide-desc { display: block; font-size: 24rpx; color: var(--text-2); }
.measure-btn { margin-bottom: 20rpx; }
.clear-btn { color: var(--text-2); }
