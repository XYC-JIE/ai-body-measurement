<!--pages/update-password/update-password.wxml-->
<view class="container">
  <!-- 头部标题 -->
  <view class="header">
    <text class="title">修改密码</text>
  </view>
  
  <!-- 当前用户信息 -->
  <view class="info-group">
    <text class="label">当前用户名</text>
    <text class="value">{{currentUsername}}</text>
  </view>
  
  <!-- 旧密码输入 -->
  <view class="input-group">
    <text class="label">旧密码</text>
    <input 
      class="input" 
      type="password" 
      password="true"
      placeholder="请输入旧密码" 
      placeholder-class="placeholder"
      value="{{oldPassword}}"
      bindinput="onOldPasswordInput"
      maxlength="16"
    />
  </view>

  <!-- 新密码输入 -->
  <view class="input-group">
    <text class="label">新密码</text>
    <input 
      class="input" 
      type="password" 
      password="true"
      placeholder="请输入新密码" 
      placeholder-class="placeholder"
      value="{{newPassword}}"
      bindinput="onNewPasswordInput"
      maxlength="16"
    />
  </view>

    <!-- 确认密码 -->
    <view class="input-group">
    <text class="label">确认密码</text>
    <input 
      class="input" 
      type="password" 
      password="true"
      placeholder="请确认密码" 
      placeholder-class="placeholder"
      value="{{confirmNewPassword}}"
      bindinput="onConfirmNewPasswordInput"
      maxlength="16"
    />
  </view>
  
  <!-- 错误提示 -->
  <view class="error" wx:if="{{errorMsg}}">
    <text>{{errorMsg}}</text>
  </view>
  
  <!-- 提交按钮 -->
  <button 
    class="submit-btn" 
    bindtap="updatePassword"
    disabled="{{!newPassword || isUpdating}}"
  >
    {{isUpdating ? '更新中...' : '确认修改'}}
  </button>
</view>