/* 页面容器 */
.container {
  padding: 30rpx;
  background-color: var(--bg);
  min-height: 100vh;
}

/* 头部样式 */
.header {
  margin-bottom: 60rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-1);
}

/* 信息组样式 */
.info-group {
  background: var(--card);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  justify-content: space-between;
  box-shadow: var(--shadow);
}

/* 输入组样式 */
.input-group {
  background: var(--card);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: var(--shadow);
}

.label {
  font-size: 32rpx;
  color: var(--text-2);
  margin-bottom: 20rpx;
  display: block;
}

.value {
  font-size: 32rpx;
  color: var(--text-1);
}

.input {
  height: 80rpx;
  border-bottom: 1rpx solid #eee;
  font-size: 36rpx;
  padding: 10rpx 0;
}

.placeholder {
  color: var(--text-3);
}

.tip {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 20rpx;
}

/* 错误提示 */
.error {
  color: #e64340;
  font-size: 28rpx;
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}

/* 提交按钮 */
.submit-btn {
  background: var(--primary);
  color: white;
  border-radius: 16rpx;
  margin: 60rpx 30rpx 0;
  font-size: 32rpx;
  height: 90rpx;
  line-height: 90rpx;
}

.submit-btn[disabled] {
  background: #ddd;
  color: var(--text-3);
}