.container { min-height: 100vh; background: var(--bg); padding: 24rpx; }
.header-card { display: flex; align-items: center; background: var(--primary-gradient); border-radius: var(--radius-lg); padding: 40rpx 30rpx; margin-bottom: 24rpx; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: rgba(255,255,255,0.25); color: #fff; font-size: 44rpx; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; }
.user-meta { flex: 1; }
.username { display: block; font-size: 36rpx; font-weight: 700; color: #fff; }
.join-date { display: block; margin-top: 8rpx; font-size: 24rpx; color: rgba(255,255,255,0.85); }
.profile-card, .stats-card, .menu-list { margin-bottom: 24rpx; }
.profile-row { display: flex; justify-content: space-between; margin-top: 16rpx; }
.profile-item { font-size: 26rpx; color: var(--text-2); }
.stats-card { display: flex; justify-content: center; }
.stats-item { text-align: center; }
.stats-num { display: block; font-size: 48rpx; font-weight: 800; color: var(--primary); }
.stats-label { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--text-3); }
.menu-item { display: flex; justify-content: space-between; padding: 26rpx 0; border-bottom: 1rpx solid #F1F5F9; font-size: 28rpx; color: var(--text-1); }
.menu-item:last-child { border-bottom: none; }
.arrow { color: var(--text-3); }
.logout-btn { margin-top: 20rpx; color: var(--danger); }
.auth-container { min-height: 100vh; background: var(--bg); padding: 24rpx; }
.auth-hero { padding: 60rpx 0 40rpx; text-align: center; }
.auth-title { display: block; font-size: 44rpx; font-weight: 800; color: var(--text-1); }
.auth-sub { display: block; margin-top: 12rpx; font-size: 26rpx; color: var(--text-2); }
.auth-input { margin-bottom: 24rpx; }
.register-link { text-align: center; color: var(--primary); font-size: 26rpx; margin-top: 24rpx; }
