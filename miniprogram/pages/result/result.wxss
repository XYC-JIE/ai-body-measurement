.container { min-height: 100vh; background: var(--bg); padding: 24rpx; display: flex; flex-direction: column; }
.header { margin-bottom: 24rpx; }
.title { font-size: 40rpx; font-weight: 800; color: var(--text-1); }
.measurement-card { display: flex; justify-content: space-between; align-items: center; background: var(--card); border-radius: var(--radius-lg); padding: 30rpx; margin-bottom: 20rpx; box-shadow: var(--shadow); }
.card-date { display: block; font-size: 30rpx; font-weight: 600; color: var(--text-1); }
.card-height { display: block; margin-top: 8rpx; font-size: 26rpx; color: var(--text-2); }
.card-arrow { color: var(--text-3); font-size: 44rpx; }
.details-header { padding: 10rpx 0 20rpx; }
.details-title { font-size: 36rpx; font-weight: 800; color: var(--text-1); }
.details-scroll { flex: 1; }
.images-tabs { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.img-tab { padding: 12rpx 32rpx; border-radius: 30rpx; background: #E2E8F0; color: var(--text-2); font-size: 26rpx; }
.img-tab.active { background: var(--primary-gradient); color: #fff; }
.image-section { background: var(--card); border-radius: var(--radius-lg); padding: 24rpx; margin-bottom: 24rpx; }
.image-frame { height: 500rpx; background: #F8FAFC; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; overflow: hidden; }
.annotated-image { max-width: 100%; max-height: 100%; }
.image-tip { text-align: center; font-size: 24rpx; color: var(--text-3); margin-top: 12rpx; }
.body-shape-card, .health-card, .trend-entry { margin-bottom: 24rpx; }
.body-shape-name { display: block; font-size: 36rpx; font-weight: 700; color: var(--primary); }
.body-shape-advice { display: block; margin-top: 12rpx; font-size: 26rpx; color: var(--text-2); line-height: 1.6; }
.metric-grid { display: flex; justify-content: space-around; margin: 20rpx 0; }
.metric-item { text-align: center; }
.metric-value { display: block; font-size: 40rpx; font-weight: 700; color: var(--primary); }
.metric-label { display: block; margin-top: 6rpx; font-size: 24rpx; color: var(--text-3); }
.health-note { display: block; font-size: 26rpx; color: var(--text-2); }
.trend-entry { display: flex; justify-content: space-between; align-items: center; font-size: 28rpx; color: var(--text-1); }
.category { margin-bottom: 24rpx; }
.category-title { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; font-size: 30rpx; font-weight: 700; color: var(--text-1); border-bottom: 1rpx solid #F1F5F9; }
.cat-arrow { font-size: 24rpx; color: var(--text-3); }
.result-list { padding: 8rpx 0; }
.result-item { display: flex; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid #F8FAFC; }
.result-item:last-child { border-bottom: none; }
.item-name { font-size: 28rpx; color: var(--text-2); }
.item-value { font-size: 28rpx; font-weight: 600; color: var(--primary); }
.button-group { display: flex; flex-direction: column; gap: 16rpx; padding-bottom: 40rpx; }
